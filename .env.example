# Client-side (bundled by Vite — anon/publishable key only, never the secret key)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-side only (Netlify Functions runtime env, and local scripts like scripts/bootstrap-admin.mjs).
# NOT prefixed with VITE_ so Vite never bundles it into client code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
